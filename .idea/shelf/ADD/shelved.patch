+import { NextRequest, NextResponse } from "next/server";
+import { createPublicClient } from "@/lib/supabase/public"; // Usa Service Role (Ignora RLS)
+import { GoogleGenAI } from "@google/genai";
+
+const apiKey = process.env.GOOGLE_GENERATIVE_AI_API_KEY || process.env.GEMINI_API_KEY;
+const genAI = new GoogleGenAI(apiKey!);
+
+export async function POST(req: NextRequest) {
+  const { mensagem, dados, etapa } = await req.json();
+  const supabase = createPublicClient();
+
+  // 1. Usar Gemini para processar a conversa e extrair dados
+  const model = genAI.getGenerativeModel({ model: "gemini-1.5-flash" });
+  
+  const prompt = `
+    Você é um assistente especializado em criar anúncios de caminhões.
+    Dados atuais do anúncio: ${JSON.stringify(dados)}
+    Mensagem do usuário: "${mensagem}"
+    
+    Responda em JSON com dois campos:
+    - "resposta": Sua mensagem para o usuário.
+    - "dadosExtraidos": Objeto com os campos (marca, modelo, preco, ano, cidade, estado, whatsapp) se encontrados.
+    - "finalizado": true se tivermos todos os dados básicos.
+  `;
+
+  const result = await model.generateContent(prompt);
+  const aiResponse = JSON.parse(result.response.text());
+
+  // 2. Se o Gemini extraiu algo, atualizamos o objeto dados
+  const novosDados = { ...dados, ...aiResponse.dadosExtraidos };
+
+  // 3. Se estiver finalizado, salvamos no banco sem erro de permissão
+  if (aiResponse.finalizado) {
+    await supabase.from("trucks").insert({
+      titulo: `${novosDados.marca} ${novosDados.modelo}`,
+      marca: novosDados.marca,
+      modelo: novosDados.modelo,
+      preco: Number(novosDados.preco),
+      cidade: novosDados.cidade,
+      estado: novosDados.estado,
+      whatsapp: novosDados.whatsapp,
+      status: "aprovado"
+    });
+  }
+
+  return NextResponse.json({
+    resposta: aiResponse.resposta,
+    dados: novosDados,
+    etapa: aiResponse.finalizado ? "finalizado" : "conversando"
+  });
+}
